{% assign site_name = site.name %}
{% if title != blank %}
  {% assign page_title = title | append: " — " | append: site_name %}
{% else %}
  {% assign page_title = site_name %}
{% endif %}
{% assign og_image_url = "" %}
{% assign social_description = site.description %}
{% if site.og_image != blank %}
  {% assign og_image_url = site.og_image.url %}
{% endif %}
{% if post %}
  {% if og_image_url == "" and post.image != blank %}
    {% assign og_image_url = post.image.url %}
  {% endif %}
  {% if post.excerpt != blank %}
    {% assign social_description = post.excerpt %}
  {% endif %}
  {% capture jsonld_post_title %}{{ post.title | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  {% capture jsonld_post_excerpt %}{{ post.excerpt | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% endif %}
{% capture jsonld_name %}{{ site.name | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% capture jsonld_desc %}{{ site.description | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ site.description }}">
    <meta name="author" content="{{ site.name }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:type" content="{% if post %}article{% else %}website{% endif %}">
    <meta property="og:description" content="{{ social_description }}">
    <meta property="og:site_name" content="{{ site_name }}">
    {% if og_image_url != blank %}
    <meta property="og:image" content="{{ og_image_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{ og_image_url }}">
    {% else %}
    <meta name="twitter:card" content="summary">
    {% endif %}
    <meta name="twitter:title" content="{{ page_title }}">
    <meta name="twitter:description" content="{{ social_description }}">

    {% assign words = site.name | split: " " %}{% assign initials = "" %}{% if words.size == 1 %}{% assign initials = words[0] | slice: 0, 2 | upcase %}{% else %}{% for word in words limit: 2 %}{% assign letter = word | slice: 0, 1 | upcase %}{% assign initials = initials | append: letter %}{% endfor %}{% endif %}{% assign initials = initials | replace: "&", "" | replace: "<", "" | replace: ">", "" | replace: "'", "" | replace: '"', "" %}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='system-ui,sans-serif' font-weight='bold' font-size='13' fill='%23e5ff00'%3E{{ initials }}%3C/text%3E%3C/svg%3E">

    <link rel="stylesheet" href="/styles.css">

    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">

    <script type="application/ld+json">
      {% if post %}
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "{{ jsonld_post_title }}"
        {%- if post.excerpt != blank -%}, "description": "{{ jsonld_post_excerpt }}"{%- endif -%}
        {%- if post.image != blank -%}, "image": "{{ post.image.url }}"{%- endif -%}
        {%- if post.date != blank -%}, "datePublished": "{{ post.date | date: '%Y-%m-%d' }}"{%- endif -%}
        , "author": { "@type": "Person", "name": "{{ jsonld_name }}" }
      }
      {% else %}
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "{{ jsonld_name }}"
        {%- if site.description != blank -%}, "description": "{{ jsonld_desc }}"{%- endif -%}
        {%- if og_image_url != blank -%}, "image": "{{ og_image_url }}"{%- endif -%}
      }
      {% endif %}
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
      <div class="header-wrapper">
        <button class="notify-toggle" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-bell-plus-icon lucide-bell-plus">
            <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
            <path d="M15 8h6"></path>
            <path d="M18 5v6"></path>
            <path d="M20.002 14.464a9 9 0 0 0 .738.863A1 1 0 0 1 20 17H4a1 1 0 0 1-.74-1.673C4.59 13.956 6 12.499 6 8a6 6 0 0 1 8.75-5.332"></path>
          </svg>
        </button>
        {% if post %}
          <p class="masthead"><a href="/">{{ site.name }}</a></p>
        {% else %}
          <h1 class="masthead"><a href="/">{{ site.name }}</a></h1>
        {% endif %}

        <!-- Dark Mode Toggle -->
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>

      <main id="main">
        {{ page_content }}

        {% if show_blog %}
          {% include "page-content" %}
        {% endif %}
      </main>

      <footer class="site-footer">
        <small>&copy; {{ "now" | date: "%Y" }} {{ site.name }}. Powered by <a href="https://archival.dev">Archival</a>.</small>
      </footer>
    </div>

    <!-- imagesLoaded for proper layout calculation -->
    <script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>

    <!-- Isotope.js for grid filtering -->
    <script src="https://unpkg.com/isotope-layout@3/dist/isotope.pkgd.min.js"></script>

    <!-- Anime.js Library v4.2.2 -->
    <script type="module">
      import { animate, createTimeline, stagger, utils } from 'https://cdn.jsdelivr.net/npm/animejs/+esm';
      // Make animate available globally for the main script
      window.animate = animate;
      window.createTimeline = createTimeline;
      window.stagger = stagger;
      window.animeUtils = utils;
    </script>

    <!-- Prism.js for syntax highlighting -->
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <!-- injected vars -->
    <script>
      window.blogState = {
        {% if post %}
        initialPostPath: "/{{ post.path }}.html",
        {% endif %}
        blogPosts: [
          {%- assign sorted_posts = posts | sort: "date" | reverse -%}
          {%- for post in sorted_posts -%}
            {%- capture html -%}
              {% include "post" post: post %}
            {%- endcapture -%}
            {
              path: "/{{ post.path }}.html",
              content: "{{ html | strip_newlines |  escape }}",
              index: {{ forloop.index }},
              tags: [
                {%- for tag in post.tag -%}
                    "{{ tag.name }}"{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }{% unless forloop.last %},{% endunless %}{% endfor %}
          ]
      }
    </script>
    <script src="/script.js" type="module"></script>
  </body>

</html>
