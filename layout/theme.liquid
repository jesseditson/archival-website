{% assign site_name = app.name %}
{% if title != blank %}
  {% assign page_title = title | append: " — " | append: site_name %}
{% else %}
  {% assign page_title = site_name %}
{% endif %}
{% if app.og_image != blank %}
  {% assign og_image_url = app.og_image.url %}
{% elsif app.logo != blank %}
  {% assign og_image_url = app.logo.url %}
{% endif %}
{% capture jsonld_name %}{{ app.name | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% capture jsonld_desc %}{{ app.description | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% capture jsonld_author %}{{ app.author | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ app.description }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ app.description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site_name }}">
  {% if og_image_url != blank %}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ og_image_url }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ app.description }}">

  {% if app.logo != blank %}
    <link rel="apple-touch-icon" href="{{ app.logo.url }}">
    <link rel="icon" href="{{ app.logo.url }}">
  {% endif %}

  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" type="text/css"
    href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/bold/style.css" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MobileApplication",
      "name": "{{ jsonld_name }}"
      {%- if app.description != blank -%}, "description": "{{ jsonld_desc }}"{%- endif -%}
      {%- if app.author != blank -%}, "author": { "@type": "Person", "name": "{{ jsonld_author }}" }{%- endif -%}
      {%- if og_image_url != blank -%}, "image": "{{ og_image_url }}"{%- endif -%}
      , "operatingSystem": "iOS, Android"
      , "applicationCategory": "MobileApplication"
    }
  </script>
</head>

<body class="{% if is_legal_page %}legal{% endif %}">
  <a href="#main" class="skip-link">Skip to content</a>
  {{ page_content }}

  <footer class="container">
    <p>&copy; {{ "now" | date: "%Y" }} {{ app.author }}. Powered by <a href="https://archival.dev">Archival</a>.</p>
    <p class="footer-legal">
      <a href="/privacy.html">Privacy</a>
      |
      <a href="/tos.html">Terms of Service</a>
      |
      <a href="/eula.html">EULA</a>
    </p>
  </footer>
</body>

</html>
