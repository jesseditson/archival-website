{% assign site_name = publication.name %}
{% if title != blank %}
  {% assign page_title = title | append: " — " | append: site_name %}
{% else %}
  {% assign page_title = site_name %}
{% endif %}
{% assign og_image_url = "" %}
{% if publication.og_image != blank %}
  {% assign og_image_url = publication.og_image.url %}
{% endif %}
{% assign social_description = publication.tagline %}
{% if page == 'story-detail' and stories %}
  {% if og_image_url == "" and stories.image != blank %}
    {% assign og_image_url = stories.image.url %}
  {% endif %}
  {% if stories.subheadline != blank %}
    {% assign social_description = stories.subheadline %}
  {% endif %}
{% endif %}
{% capture jsonld_pub_name %}{{ publication.name | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% capture jsonld_pub_desc %}{{ publication.tagline | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% if page == 'story-detail' and stories %}
  {% capture jsonld_headline %}{{ stories.headline | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  {% capture jsonld_subhead %}{{ stories.subheadline | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  {% capture jsonld_author %}{{ stories.author | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% endif %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ page_title }}</title>
    <meta name="description" content="{{ social_description }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:type" content="{% if page == 'story-detail' %}article{% else %}website{% endif %}">
    <meta property="og:description" content="{{ social_description }}">
    <meta property="og:site_name" content="{{ site_name }}">
    {% if og_image_url != blank %}
    <meta property="og:image" content="{{ og_image_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="{{ og_image_url }}">
    {% else %}
    <meta name="twitter:card" content="summary">
    {% endif %}
    <meta name="twitter:title" content="{{ page_title }}">
    <meta name="twitter:description" content="{{ social_description }}">

    <script>
      (function(){var s=localStorage.getItem('theme');if(s==='dark'||(! s&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.setAttribute('data-theme','dark')}})();
    </script>
    <link rel="stylesheet" href="/styles.css">

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
    {% assign words = publication.name | split: " " %}{% assign initials = "" %}{% if words.size == 1 %}{% assign initials = words[0] | slice: 0, 2 | upcase %}{% else %}{% for word in words limit: 2 %}{% assign letter = word | slice: 0, 1 | upcase %}{% assign initials = initials | append: letter %}{% endfor %}{% endif %}{% assign initials = initials | replace: "&", "" | replace: "<", "" | replace: ">", "" | replace: "'", "" | replace: '"', "" %}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='system-ui,sans-serif' font-weight='bold' font-size='13' fill='%23e5ff00'%3E{{ initials }}%3C/text%3E%3C/svg%3E">

    <script type="application/ld+json">
      {% if page == 'story-detail' and stories %}
      {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        "headline": "{{ jsonld_headline }}"
        {%- if stories.subheadline != blank -%}, "description": "{{ jsonld_subhead }}"{%- endif -%}
        {%- if stories.image != blank -%}, "image": "{{ stories.image.url }}"{%- endif -%}
        {%- if stories.author != blank -%}, "author": { "@type": "Person", "name": "{{ jsonld_author }}" }{%- endif -%}
        , "publisher": { "@type": "NewsMediaOrganization", "name": "{{ jsonld_pub_name }}" }
      }
      {% else %}
      {
        "@context": "https://schema.org",
        "@type": "NewsMediaOrganization",
        "name": "{{ jsonld_pub_name }}"
        {%- if publication.tagline != blank -%}, "description": "{{ jsonld_pub_desc }}"{%- endif -%}
        {%- if og_image_url != blank -%}, "image": "{{ og_image_url }}"{%- endif -%}
      }
      {% endif %}
    </script>
  </head>

  <body class="{{ page }}">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <nav class="nav-sections" aria-label="Sections">
          {% unless active_section %}{% assign active_section = "" %}{% endunless %}
          {% for section in objects.sections %}
            <a class="nav-link{% if section.name == active_section %} nav-link--active{% endif %}" href="/sections/{{ section.slug }}.html">{{ section.name }}</a>
          {% endfor %}
        </nav>
        <div class="masthead">
          <a href="/" class="masthead-link">
            <h1 class="site-name">{{ publication.name }}</h1>
          </a>
          <p class="site-tagline">{{ publication.tagline }}</p>
        </div>
        <div class="header-rule"></div>
      </div>
    </header>

    <main id="main">
      {{ page_content }}
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-rule"></div>
        <div class="theme-toggle-wrap">
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
            <span class="toggle-icon toggle-sun">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </span>
            <span class="toggle-knob"></span>
            <span class="toggle-icon toggle-moon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </span>
          </button>
        </div>
        <p class="footer-copyright">&copy; {{ "now" | date: "%Y" }} {{ publication.name }}. Powered by <a href="https://archival.dev">Archival</a>.</p>
      </div>
    </footer>

    <script>
      (function() {
        var toggle = document.getElementById('theme-toggle');
        var root = document.documentElement;
        var stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          root.setAttribute('data-theme', 'dark');
        }
        toggle.addEventListener('click', function() {
          var isDark = root.getAttribute('data-theme') === 'dark';
          if (isDark) {
            root.removeAttribute('data-theme');
            localStorage.setItem('theme', 'light');
          } else {
            root.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      })();
    </script>
  </body>

</html>
