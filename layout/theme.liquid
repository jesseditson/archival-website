{% assign site_name = objects.band.name %}
{% if title != blank %}
  {% assign page_title = title | append: " — " | append: site_name %}
{% else %}
  {% assign page_title = site_name %}
{% endif %}
{% if objects.band.og_image != blank %}
  {% assign og_image_url = objects.band.og_image.url %}
{% elsif objects.band.image != blank %}
  {% assign og_image_url = objects.band.image.url %}
{% endif %}
{% capture jsonld_name %}{{ objects.band.name | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
{% capture jsonld_desc %}{{ objects.band.description | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>{{ page_title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ objects.band.description }}">
  <meta name="author" content="{{ objects.band.name }}">

  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ objects.band.description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site_name }}">
  {% if og_image_url != blank %}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ og_image_url }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ objects.band.description }}">

  <link rel="preload" href="/fonts/Kaffe-Regular.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles/global.css">

  {% assign words = objects.band.name | split: " " %}{% assign initials = "" %}{% if words.size == 1 %}{% assign initials = words[0] | slice: 0, 2 | upcase %}{% else %}{% for word in words limit: 2 %}{% assign letter = word | slice: 0, 1 | upcase %}{% assign initials = initials | append: letter %}{% endfor %}{% endif %}{% assign initials = initials | replace: "&", "" | replace: "<", "" | replace: ">", "" | replace: "'", "" | replace: '"', "" %}
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='system-ui,sans-serif' font-weight='bold' font-size='13' fill='%23e5ff00'%3E{{ initials }}%3C/text%3E%3C/svg%3E">
  <style>
    :root {
      --band-background: url('{{ objects.band.image.url }}');
    }
  </style>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "MusicGroup",
      "name": "{{ jsonld_name }}"
      {%- if objects.band.description != blank -%}, "description": "{{ jsonld_desc }}"{%- endif -%}
      {%- if og_image_url != blank -%}, "image": "{{ og_image_url }}"{%- endif -%}
    }
  </script>
</head>

<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <div class="container">
    <div class="background-image"></div>
    <div class="screen"></div>

    <div class="content">
      <!-- Logo, Nav, Player -->
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"></button>

      <!-- Mobile Fullscreen Menu -->
      <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile">
        <button class="close-menu" aria-label="Close menu"></button>
        <ul class="mobile-nav-list">
          <li><a href="/" class="mobile-nav-link{% if page == 'latest' %} active{% endif %}">Latest</a></li>
          <li><a href="/releases" class="mobile-nav-link{% if page == 'releases' %} active{% endif %}">Releases</a>
          </li>
          <li><a href="/tour" class="mobile-nav-link{% if page == 'tour' %} active{% endif %}">Tour</a></li>
          <li><a href="/about" class="mobile-nav-link{% if page == 'about' %} active{% endif %}">About</a></li>
          {% if objects.band.merch_url != blank %}
            <li><a href="{{ objects.band.merch_url }}" class="mobile-nav-link" target="_blank" rel="noopener">Merch 🡭</a></li>
          {% endif %}
        </ul>
      </nav>

      <div class="logo-nav-container">

        <a class="logo-wrapper" href="/">
          <span class="logo">{{ objects.band.name }}</span>
        </a>

        <nav class="primary-nav" aria-label="Main">
          <ul class="nav-list">
            <li class="nav-item">
              <a href="/" class="nav-link{% if page == 'latest' %} active{% endif %}">Latest</a>
            </li>
            <li class="nav-item">
              <a href="/releases" class="nav-link{% if page == 'releases' %} active{% endif %}">Releases</a>
            </li>
            <li class="nav-item">
              <a href="/tour" class="nav-link{% if page == 'tour' %} active{% endif %}">Tour</a>
            </li>
            <li class="nav-item">
              <a href="/about" class="nav-link{% if page == 'about' %} active{% endif %}">About</a>
            </li>
            {% if objects.band.merch_url != blank %}
              <li class="nav-item">
                <a href="{{ objects.band.merch_url }}" class="nav-link" target="_blank" rel="noopener">Merch 🡭</a>
              </li>
            {% endif %}
          </ul>
        </nav>
        <div class="player">
          <div class="player-progress-clip"><div class="player-progress"></div></div>
          <button class="play-pause" aria-label="Play/Pause"></button>
          <div class="now-playing">
            <span class="now-playing-label">Now Playing:</span>
            <span class="now-playing-item"></span>
          </div>
          <div class="volume-wrapper">
            <button class="volume" aria-label="Volume"></button>
            <div class="volume-flyout">
              <input type="range" class="volume-slider" min="0" max="100" value="80" aria-label="Volume">
            </div>
          </div>
        </div>
        <script>
          window.__tracks = [
            {% for track in objects.track %}
              { title: "{{ track.title }}", url: "{{ track.audio.url }}" }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ];
        </script>
      </div>

      <main id="main" class="page-content">
        {{ page_content }}
      </main>
      <footer class="site-footer">
        <span>&copy; {{ "now" | date: "%Y" }} {{ objects.band.name }}. Powered by <a href="https://archival.dev">Archival</a>.</span>
      </footer>
    </div>
  </div>
  <script src="/scripts/global.js"></script>
</body>

</html>
