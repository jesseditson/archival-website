{% assign site_name = objects.personal.name %}
{% if objects.personal.title != blank %}
  {% assign site_title = objects.personal.name | append: " | " | append: objects.personal.title %}
{% else %}
  {% assign site_title = objects.personal.name %}
{% endif %}
{% if title != blank %}
  {% assign page_title = title | append: " — " | append: site_name %}
{% else %}
  {% assign page_title = site_title %}
{% endif %}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>{{ page_title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ objects.personal.tagline }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ objects.personal.tagline }}">
  <meta property="og:type" content="profile">
  <meta property="og:site_name" content="{{ site_name }}">
  {% if objects.personal.og_image != blank %}
  <meta property="og:image" content="{{ objects.personal.og_image.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ objects.personal.og_image.url }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ page_title }}">
  <meta name="twitter:description" content="{{ objects.personal.tagline }}">
  <!-- Link to CSS -->
  <link rel="stylesheet" href="/styles.css">
  {% assign words = objects.personal.name | split: " " %}{% assign initials = "" %}{% if words.size == 1 %}{% assign initials = words[0] | slice: 0, 2 | upcase %}{% else %}{% for word in words limit: 2 %}{% assign letter = word | slice: 0, 1 | upcase %}{% assign initials = initials | append: letter %}{% endfor %}{% endif %}{% assign initials = initials | replace: "&", "" | replace: "<", "" | replace: ">", "" | replace: "'", "" | replace: '"', "" %}
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111'/%3E%3Ctext x='16' y='21' text-anchor='middle' font-family='system-ui,sans-serif' font-weight='bold' font-size='13' fill='%23e5ff00'%3E{{ initials }}%3C/text%3E%3C/svg%3E">
  {% capture jsonld_name %}{{ objects.personal.name | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  {% capture jsonld_jobtitle %}{{ objects.personal.title | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  {% capture jsonld_desc %}{{ objects.personal.tagline | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  {% capture jsonld_email %}{{ objects.contact.email | replace: '\', '\\' | replace: '"', '\"' | strip_newlines }}{% endcapture %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{{ jsonld_name }}"
      {%- if objects.personal.title != blank -%}, "jobTitle": "{{ jsonld_jobtitle }}"{%- endif -%}
      {%- if objects.personal.tagline != blank -%}, "description": "{{ jsonld_desc }}"{%- endif -%}
      {%- if objects.personal.og_image != blank -%}, "image": "{{ objects.personal.og_image.url }}"{%- endif -%}
      {%- if objects.contact.email != blank -%}, "email": "{{ jsonld_email }}"{%- endif -%}
    }
  </script>
</head>

<body>
  {{ page_content }}

  <!-- JavaScript -->
  <script src="/script.js"></script>
</body>

</html>
