{% if event_link != "" %}
<a href="{{ event_link }}" class="event-card event-card-clickable" target="_blank" rel="noopener noreferrer">
{% else %}
<article class="event-card">
{% endif %}
  {% if event_image and event_image.url != "" %}
    <img class="event-card-image" src="{{ event_image.url }}" alt="{{ event_title }}">
  {% endif %}
  <span class="label">{{ event_date | date: "%B %d, %Y" }}</span>
  <h3>{{ event_title }}</h3>
  <div>{{ event_description }}</div>
  {% if event_link != "" %}
    <span class="event-card-link">Learn More &rarr;</span>
  {% endif %}
{% if event_link != "" %}
</a>
{% else %}
</article>
{% endif %}
