<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <a href="/" class="footer-brand-link">
          {% assign show_footer_logo = false %}
          {% if objects.site.logo %}{% if objects.site.logo.url != "" %}{% assign show_footer_logo = true %}{% endif %}{% endif %}
          {% if show_footer_logo %}
            <img src="{{ objects.site.logo.url }}" alt="{{ objects.site.name }}" class="footer-brand-logo">
          {% else %}
            <span class="footer-brand-name">{{ objects.site.name }}</span>
          {% endif %}
          {% if objects.site.tagline %}
            <span class="footer-brand-tagline">{{ objects.site.tagline }}</span>
          {% endif %}
        </a>
      </div>

      <div class="footer-col">
        <h4>Visit</h4>
        <p>{{ objects.contact.address | replace_first: ", ", "<br>" }}</p>
        {% if objects.contact.phone %}
          <p><a href="tel:{{ objects.contact.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' }}">{{ objects.contact.phone }}</a></p>
        {% endif %}
        {% if objects.contact.email %}
          <p><a href="mailto:{{ objects.contact.email }}">{{ objects.contact.email }}</a></p>
        {% endif %}
      </div>

      <div class="footer-col footer-hours">
        <h4>Hours</h4>
        <table class="footer-hours-table">
          {% for h in objects.hours %}
          <tr><td>{{ h.day }}</td><td>{{ h.time }}</td></tr>
          {% endfor %}
        </table>
      </div>

      <div class="footer-col">
        <h4>Connect</h4>
        {% if objects.contact.instagram %}
          {% assign ig_handle = objects.contact.instagram | remove: '@' %}
          <p><a href="https://instagram.com/{{ ig_handle }}" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram">Instagram</a></p>
        {% endif %}
        {% if objects.site.reservation_url %}
          <p><a href="{{ objects.site.reservation_url }}" target="_blank" rel="noopener noreferrer">Reservations</a></p>
        {% endif %}
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {{ "now" | date: "%Y" }} {{ objects.site.name }}. Powered by <a href="https://archival.dev" target="_blank" rel="noopener noreferrer">Archival</a>.</p>
    </div>
  </div>
</footer>
