{%- comment -%} The outlined button, for the header and the small-screen menu. {%- endcomment -%}
{%- assign site = objects.site -%}
{%- if site.primary_url != blank -%}
{%- if site.header_cta_label != blank -%}{%- assign cta_label = site.header_cta_label -%}{%- elsif site.primary_label != blank -%}{%- assign cta_label = site.primary_label -%}{%- else -%}{%- assign cta_label = "Get started" -%}{%- endif -%}
<a class="pill pill--outline" href="{{ site.primary_url | strip | escape }}" data-enter="header">{{ cta_label | escape }}</a>
{%- endif -%}
