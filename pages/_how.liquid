{%- comment -%}
  The steps, in order, beside a smaller stack with one glass layer per step
  (up to six). scripts/art.ts plays through the steps on a loop while the
  section is on screen: the current step opens and its layer lifts.
  Choosing a step moves the loop there. Without script, or for visitors who
  ask for less motion, every step stays open and every layer lit.
{%- endcomment -%}
{%- assign site = objects.site -%}
{%- if site.show_how != false and objects.step.size > 0 %}
{%- assign slab_count = objects.step.size -%}
{%- if slab_count > 6 -%}{%- assign slab_count = 6 -%}{%- endif %}
<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="how-title">{% if site.how_heading != blank %}{{ site.how_heading | escape }}{% else %}How it works{% endif %}</h2>
      {%- if site.how_intro != blank %}
      <p>{{ site.how_intro | escape }}</p>
      {%- endif %}
    </div>
    <div class="how__inner">
      <ol class="how__steps">
        {%- for step in objects.step %}
        <li class="how-step" data-step="{{ forloop.index }}">
          <span class="how-step__number" aria-hidden="true">{{ forloop.index }}</span>
          <h3><button class="how-step__button" type="button" aria-controls="how-step-text-{{ forloop.index }}">{{ step.title | escape }}</button></h3>
          {%- if step.text != blank %}
          <div class="how-step__body" id="how-step-text-{{ forloop.index }}"><p>{{ step.text | escape }}</p></div>
          {%- endif %}
          <span class="how-step__progress" aria-hidden="true"></span>
        </li>
        {%- endfor %}
      </ol>
      <div class="how__art">
        {%- assign slab_density = "lite" -%}{%- assign slab_class = "art--steps" -%}
        {% include 'slabs' %}
      </div>
    </div>
  </div>
</section>
{%- endif -%}
