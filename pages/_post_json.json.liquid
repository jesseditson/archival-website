{
    "link": "{{ site_url }}/{{ post.path }}.html",
    "title": "{{ post.title }}",
    "date": "{{ post.date | date: "%a, %d %b %Y %H:%M:%S %z" }}",
    {%- unless post.excerpt == blank -%}"excerpt": "{{post.excerpt}}",{% endunless %}
    {%- unless post.content == blank -%}"content": "{{post.content | strip_newlines | escape}}",{% endunless %}
    {%- unless post.media == blank -%}
    {%- case post.media.type -%}
    {%- when "image" -%}"imageUrl": "{{post.media.value.url}}",
    {%- when "video" -%}"videoUrl": "{{post.media.value.url}}",
    {%- when "audio" -%}"audioUrl": "{{post.media.value.url}}",
    {%- when "link" -%}"linkUrl": "{{post.media.value}}",
    {%- endcase -%}
    {%- endunless -%}
    "index": {{ forloop.index }},
    "tags": [
        {%- assign tag_list = post.tags | split: "," -%}
        {%- for tag in tag_list -%}
            {%- assign trimmed_tag = tag | strip -%}
            "{{tag}}"{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
    ]
}
