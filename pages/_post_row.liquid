{%- comment -%} One post in a list: text on the left, its picture slot (see _cover) on the right. Arg: p. {%- endcomment -%}
<article class="post-row has-image">
  <div class="post-row-text">
    {% include 'primary_tag' %}
    <h3 class="post-row-title"><a href="/{{ p.path }}">{{ p.title | escape }}</a></h3>
    {% if p.excerpt != blank %}<p class="post-row-excerpt">{{ p.excerpt | escape }}</p>{% endif %}
    {% include 'byline' %}
  </div>
  {% include 'cover', cover_class: "post-row-image" %}
</article>
