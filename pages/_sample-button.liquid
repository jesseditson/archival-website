{%- comment -%}
  A play button for a short recording. Needs `sample_url` and
  `sample_label`. /js/player.js queues every [data-track] button on the
  page in page order.
{%- endcomment -%}
<button type="button" class="play" data-track data-src="{{ sample_url | escape }}" data-title="{{ sample_label | escape }}" aria-label="Play {{ sample_label | escape }}" aria-pressed="false"><svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19.5 12z" fill="currentColor"/></svg><svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg></button>
