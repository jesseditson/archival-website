{%- comment -%} Round icon buttons for every social link with a URL. {%- endcomment -%}
{%- assign social_count = 0 -%}
{%- for social in objects.site.social -%}{%- if social.url != blank -%}{%- assign social_count = social_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if social_count > 0 -%}
<ul class="socials">
  {%- for social in objects.site.social -%}
  {%- if social.url != blank -%}
  {%- if social.label != blank -%}{%- assign social_name = social.label -%}{%- else -%}{%- assign social_name = social.platform | capitalize -%}{%- endif -%}
  {%- assign link = social.url | strip -%}{%- include 'link-href' -%}
  <li><a class="social" href="{{ link_href | escape }}" aria-label="{{ social_name | escape }}">{% include 'social-icon' %}</a></li>
  {%- endif -%}
  {%- endfor -%}
</ul>
{%- endif -%}
