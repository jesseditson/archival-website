{% layout 'theme' title: "Archival Website" %}

<!-- Navigation Bar -->
<nav class="navbar">
  <div class="container">
    <a href="#" class="logo">{{ objects.personal.name }}</a>
    <ul class="nav-links">
      <li>
        <a href="#about">About</a>
      </li>
      <li>
        <a href="#experience">Experience</a>
      </li>
      <li>
        <a href="#work">Work</a>
      </li>
      <li>
        <a href="#contact">Contact</a>
      </li>
      {% if objects.resume.file %}
        <li>
          <a
            href="{{ objects.resume.file.url }}"
            class="resume-button"
            download="{{ objects.resume.file.filename }}">Resume</a>
        </li>
      {% endif %}
    </ul>
    <div class="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</nav>

<!-- Hero Section -->
<section id="hero">
  <div class="container">
    <p class="intro">Hi, my name is</p>
    <h1 class="name">{{ objects.personal.name }} &amp;</h1>
    <h2 class="profession">{{ objects.personal.action_line }}</h2>
    <p class="description">
      {{ objects.personal.tagline }}
    </p>
    <a href="#about" class="cta">More about me</a>
  </div>
</section>

<!-- About Section -->
<section id="about">
  <div class="container">
    <h2 class="section-title">About Me</h2>
    <div class="content">
      <div class="text">
        {{ objects.personal.full_about }}
      </div>
    </div>
  </div>
</section>

<!-- Experience Section -->
<section id="experience">
  <div class="container">
    <h2 class="section-title">{{ experience.title }}</h2>
    <!-- Experience Tabs -->
    <div class="experience">
      {{ objects.experience.description }}
    </div>
  </div>
</section>

<!-- Work Section -->
<section id="work">
  <div class="container">
    <h2 class="section-title">{{ work.title }}</h2>
    <!-- Projects -->
    <div class="projects">
      {% for project in work.project %}
        <div class="project-item">
          <div class="project-content">
            <h3>{{ project.name }}</h3>
            <p>{{ project.description }}</p>
            <div class="project-tags">
              {%- assign tags = project.tags | split: "," -%}
              {%- for tag in tags -%}
                <span>{{ tag | strip }}</span>
              {%- endfor -%}
            </div>
          </div>
          {%- unless project.image == blank -%}
            <div class="project-image">
              <img src="{{project.image.url}}" alt="{{project.name}}">
            </div>
          {%- endunless -%}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact">
  <div class="container">
    <div class="contact-card">
      <h2 class="section-title">{{ contact.title }}</h2>
      <div>
        {{ objects.contact.description }}
        <a href="mailto:{{ objects.contact.email }}" class="email-link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="position: relative; z-index: 1;">
            <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
            <path d="m21.854 2.147-10.94 10.939" />
          </svg>
          <span style="position: relative; z-index: 1;">Say Hello</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer>
  <div class="container">
    <p>&copy; {{ "now" | date: "%Y" }} {{ objects.personal.name }}. Powered by <a href="https://archival.dev">Archival</a>.</p>
  </div>
</footer>
