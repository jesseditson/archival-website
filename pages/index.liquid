{%- assign site = objects.site -%}
{%- assign record = objects.record -%}
{%- assign tracks = objects.track | sort: "order" -%}
{%- assign credits = objects.credit | sort: "order" -%}
{%- assign quotes = objects.press | sort: "order" -%}
{%- assign playable = 0 -%}
{%- for track in tracks -%}{%- if track.audio != blank -%}{%- assign playable = playable | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- capture jsonld -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicAlbum",
  "name": "{{ record.title | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}",
  "byArtist": {"@type": "MusicGroup", "name": "{{ site.name | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"},
  "url": "{{ site_url }}/"
  {%- if site.description != blank -%}, "description": "{{ site.description | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- endif -%}
  {%- if record.released != blank -%}, "datePublished": "{{ record.released | date: '%Y-%m-%d' }}"{%- endif -%}
  {%- if record.cover != blank -%}, "image": "{{ record.cover.url | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- endif -%}
  {%- if tracks.size > 0 -%}, "numTracks": {{ tracks.size }}, "track": [
    {%- for track in tracks -%}{"@type": "MusicRecording", "position": {{ forloop.index }}, "name": "{{ track.title | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}", "url": "{{ site_url }}/{{ track.path }}"}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}]
  {%- endif %}
}
</script>
{%- endcapture -%}
{% layout 'theme' title: "", path: "", jsonld: jsonld %}

{%- assign title_words = record.title | split: " " %}
<section class="hero" aria-labelledby="record-title">
  <div class="wrap hero-inner">
    <div class="hero-title-box">
      <h1 id="record-title" class="record-title">
        {%- for word in title_words %}<span class="word" style="--i: {{ forloop.index0 }}">{{ word | escape }}</span>{% unless forloop.last %} {% endunless %}{% endfor -%}
      </h1>
    </div>
    <div class="sleeve-stage">
      <div class="vinyl" aria-hidden="true">
        <div class="vinyl-turn">
          <div class="vinyl-disc">
            <div class="vinyl-label">{% if record.cover != blank %}<img src="{{ record.cover.url | escape }}" alt="">{% endif %}</div>
          </div>
        </div>
      </div>
      <div class="sleeve">
        {%- if record.cover != blank %}
        <img class="cover" src="{{ record.cover.url | escape }}" alt="{{ record.cover_alt | escape }}">
        {%- endif %}
      </div>
    </div>
    <div class="hero-meta">
      <p class="artist">{{ site.name | escape }}</p>
      {%- if record.released != blank or record.label != blank %}
      <p class="release">{% if record.released != blank %}Out {{ record.released | date: "%B %-d, %Y" }}{% endif %}{% if record.released != blank and record.label != blank %}<br>{% endif %}{% if record.label != blank %}{{ record.label | escape }}{% endif %}</p>
      {%- endif %}
      {%- if playable > 0 %}
      <button type="button" class="play-all" data-play-all>Play the record</button>
      {%- endif %}
    </div>
  </div>
</section>

{%- if tracks.size > 0 %}
<section class="tracklist" aria-labelledby="tracklist-title">
  <div class="wrap">
    <h2 id="tracklist-title" class="section-title">Tracklist</h2>
    <ol class="tracks">
      {%- for track in tracks %}
      {%- assign track_number = forloop.index %}
      <li class="track-row" data-row>
        <span class="track-number" aria-hidden="true"><span class="track-digits">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><span class="track-eq"><i></i><i></i><i></i></span></span>
        <a class="track-title" href="/{{ track.path }}">{{ track.title | escape }}</a>
        {%- if track.duration != blank %}
        <span class="track-duration">{{ track.duration | escape }}</span>
        {%- endif %}
        {%- if track.audio != blank %}{% include 'play-button' %}{% endif %}
        <span class="track-progress" aria-hidden="true"></span>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
{%- endif %}

{%- if record.blurb != blank or site.bio != blank %}
<section class="about" aria-labelledby="about-title">
  <div class="wrap about-grid">
    {%- if site.portrait != blank %}
    <figure class="portrait"><img src="{{ site.portrait.url | escape }}" alt="{{ site.portrait_alt | escape }}" loading="lazy"></figure>
    {%- endif %}
    <div class="about-text">
      <h2 id="about-title" class="section-title">About the record</h2>
      {%- if record.blurb != blank %}
      <div class="blurb markdown">{{ record.blurb | replace: "<h1", "<h3" | replace: "</h1>", "</h3>" | replace: "<h2", "<h3" | replace: "</h2>", "</h3>" }}</div>
      {%- endif %}
      {%- if site.bio != blank %}
      <div class="bio markdown">{{ site.bio | replace: "<h1", "<h3" | replace: "</h1>", "</h3>" | replace: "<h2", "<h3" | replace: "</h2>", "</h3>" }}</div>
      {%- endif %}
    </div>
  </div>
</section>
{%- endif %}

{%- assign quote_count = 0 -%}
{%- for item in quotes -%}{%- if item.quote != blank -%}{%- assign quote_count = quote_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if quote_count > 0 %}
<section class="press" aria-labelledby="press-title">
  <h2 id="press-title" class="visually-hidden">What people said</h2>
  <div class="marquee">
    <ul class="marquee-track">
      {%- for item in quotes %}{% if item.quote != blank %}
      <li class="press-quote">
        <blockquote><p>{{ item.quote | escape }}</p></blockquote>
        {%- if item.source != blank %}
        <p class="press-source">{% if item.url != blank %}{%- assign link = item.url | strip -%}{%- include 'link-href' -%}<a href="{{ link_href | escape }}">{{ item.source | escape }}</a>{% else %}{{ item.source | escape }}{% endif %}</p>
        {%- endif %}
      </li>
      {%- endif %}{% endfor %}
    </ul>
    {%- comment -%} A second copy so the loop never shows a gap; hidden from assistive tech. {%- endcomment %}
    <ul class="marquee-track" aria-hidden="true">
      {%- for item in quotes %}{% if item.quote != blank %}
      <li class="press-quote"><blockquote><p>{{ item.quote | escape }}</p></blockquote>{% if item.source != blank %}<p class="press-source">{{ item.source | escape }}</p>{% endif %}</li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- if credits.size > 0 %}
<section class="credits" aria-labelledby="credits-title">
  <div class="wrap">
    <h2 id="credits-title" class="section-title">Credits</h2>
    <dl class="credit-list">
      {%- for credit in credits %}{% if credit.name != blank %}
      <div class="credit"><dt>{{ credit.role | escape }}</dt><dd>{{ credit.name | escape }}</dd></div>
      {%- endif %}{% endfor %}
    </dl>
  </div>
</section>
{%- endif %}
