{%- assign site = objects.site -%}
{%- assign members = objects.member | sort: "order" -%}
{%- assign formats = objects.format | sort: "order" -%}
{%- assign moments = objects.moment | sort: "order" -%}
{%- assign concerts = objects.concert | sort: "date" -%}
{%- assign kind_words = objects.kind_word | sort: "order" -%}
{%- capture jsonld -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": "{{ site.name | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}",
  "url": "{{ site_url }}/"
  {%- if site.description != blank -%}, "description": "{{ site.description | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- endif -%}
  {%- if site.email != blank -%}, "email": "{{ site.email | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- endif -%}
  {%- if site.location != blank -%}, "location": {"@type": "Place", "name": "{{ site.location | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"}{%- endif -%}
  {%- if members.size > 0 -%}, "member": [
    {%- for member in members -%}{"@type": "Person", "name": "{{ member.name | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- if member.instrument != blank -%}, "roleName": "{{ member.instrument | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- endif -%}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}]
  {%- endif -%}
  {%- if formats.size > 0 -%}, "makesOffer": [
    {%- for format in formats -%}{"@type": "Offer", "name": "{{ format.name | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"{%- if format.fee != blank -%}, "description": "{{ format.fee | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% if format.length != blank %}. {{ format.length | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endif %}"{%- endif -%}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}]
  {%- endif -%}
  {%- if concerts.size > 0 -%}, "event": [
    {%- for concert in concerts -%}{"@type": "MusicEvent", "name": "{{ concert.title | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}", "startDate": "{{ concert.date | date: '%Y-%m-%d' }}"{%- if concert.venue != blank or concert.city != blank -%}, "location": {"@type": "Place", "name": "{{ concert.venue | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}", "address": "{{ concert.city | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}"}{%- endif -%}}{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}]
  {%- endif %}
}
</script>
{%- endcapture -%}
{% layout 'theme' title: "", path: "", jsonld: jsonld %}

{%- comment -%} Headings and labels come from the site object, with fallbacks. {%- endcomment -%}
{%- if site.listen_label != blank -%}{%- assign listen_label = site.listen_label -%}{%- else -%}{%- assign listen_label = "Hear us play" -%}{%- endif -%}
{%- if site.players_heading != blank -%}{%- assign players_heading = site.players_heading -%}{%- else -%}{%- assign players_heading = "The players" -%}{%- endif -%}
{%- if site.formats_heading != blank -%}{%- assign formats_heading = site.formats_heading -%}{%- else -%}{%- assign formats_heading = "Formats & fees" -%}{%- endif -%}
{%- if site.repertoire_heading != blank -%}{%- assign repertoire_heading = site.repertoire_heading -%}{%- else -%}{%- assign repertoire_heading = "Repertoire" -%}{%- endif -%}
{%- if site.kind_words_heading != blank -%}{%- assign kind_words_heading = site.kind_words_heading -%}{%- else -%}{%- assign kind_words_heading = "Kind words" -%}{%- endif -%}
{%- if site.concerts_heading != blank -%}{%- assign concerts_heading = site.concerts_heading -%}{%- else -%}{%- assign concerts_heading = "Concerts" -%}{%- endif -%}
{%- comment -%} An ampersand in a heading is set smaller and in italic. {%- endcomment -%}
{%- assign formats_heading_html = formats_heading | escape | replace: "&amp;", '<span class="amp">&amp;</span>' -%}

{%- comment -%}
  The name is set in two voices: every word but the last in the light
  serif, the last word in the bold sans ("The Quarry Light" / "Quartet").
  --longest sizes it so its longest word always fits.
{%- endcomment -%}
{%- assign name_words = site.name | split: " " -%}
{%- assign longest = 1 -%}
{%- for word in name_words -%}{%- assign word_size = word | size -%}{%- if word_size > longest -%}{%- assign longest = word_size -%}{%- endif -%}{%- endfor -%}
{%- assign last_word = name_words.last -%}
{%- assign first_words = "" -%}
{%- for word in name_words -%}{%- unless forloop.last -%}{%- if first_words != "" -%}{%- assign first_words = first_words | append: " " -%}{%- endif -%}{%- assign first_words = first_words | append: word -%}{%- endunless -%}{%- endfor -%}
{%- assign word_count = 0 -%}
{%- for word in kind_words -%}{%- if word.quote != blank -%}{%- assign word_count = word_count | plus: 1 -%}{%- endif -%}{%- endfor %}

<header class="hero{% if site.hero_image == blank and site.hero_video == blank %} hero-plain{% endif %}" id="top">
  {%- if site.hero_image != blank %}
  <img class="hero-media" src="{{ site.hero_image.url | escape }}" alt="{{ site.hero_alt | escape }}">
  {%- endif %}
  {%- if site.hero_video != blank %}
  <video class="hero-media hero-video" autoplay muted loop playsinline preload="metadata"{% if site.hero_image != blank %} poster="{{ site.hero_image.url | escape }}"{% endif %} aria-hidden="true" tabindex="-1"><source src="{{ site.hero_video.url | escape }}" type="video/mp4"></video>
  {%- endif %}
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content">
    {%- if site.location != blank %}
    <p class="kicker hero-in" style="--delay: 100ms">{{ site.location | escape }}</p>
    {%- endif %}
    <h1 class="hero-name hero-in" style="--delay: 250ms; --longest: {{ longest }}">
      {%- if first_words != "" %}<span class="name-serif">{{ first_words | escape }}</span> {% endif -%}
      <span class="name-sans">{{ last_word | escape }}</span>
    </h1>
    {%- if site.tagline != blank %}
    <p class="hero-tagline hero-in" style="--delay: 400ms">{{ site.tagline | escape }}</p>
    {%- endif %}
    {%- if site.sample != blank %}
    {%- if site.sample_title != blank %}{% assign sample_label = site.sample_title %}{% else %}{% assign sample_label = "A recording of us" %}{% endif %}
    <div class="hero-listen hero-in" style="--delay: 550ms">
      <button type="button" class="play glass pill-button" data-track data-src="{{ site.sample.url | escape }}" data-title="{{ sample_label | escape }}" aria-label="Play {{ sample_label | escape }}" aria-pressed="false"><svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19.5 12z" fill="currentColor"/></svg><svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"/></svg><span class="pill-text">{{ listen_label | escape }}</span></button>
      <p class="hero-sample">{{ sample_label | escape }}</p>
    </div>
    {%- endif %}
  </div>
  {%- if site.scene_fog != blank %}
  <img class="fog fog-hero" src="{{ site.scene_fog.url | escape }}" alt="" aria-hidden="true">
  {%- endif %}
</header>

{%- if site.intro != blank or members.size > 0 or site.players_image != blank %}
<section class="players{% if site.players_image == blank %} players-plain{% endif %}" aria-labelledby="players-title">
  {%- if site.players_image != blank %}
  <img class="players-media" src="{{ site.players_image.url | escape }}" alt="{{ site.players_alt | escape }}" loading="lazy">
  {%- endif %}
  <div class="players-shade" aria-hidden="true"></div>
  <div class="players-content">
    <h2 id="players-title" class="display-title reveal">{{ players_heading | escape }}</h2>
    {%- if site.intro != blank %}
    <div class="players-intro markdown reveal" style="--delay: 150ms">{{ site.intro | replace: "<h1", "<h3" | replace: "</h1>", "</h3>" | replace: "<h2", "<h3" | replace: "</h2>", "</h3>" }}</div>
    {%- endif %}
    {%- if members.size > 0 %}
    <ul class="members reveal" style="--delay: 300ms">
      {%- for member in members %}{% if member.name != blank %}
      <li><span class="member-name">{{ member.name | escape }}</span>{% if member.instrument != blank %}<span class="member-instrument">{{ member.instrument | escape }}</span>{% endif %}</li>
      {%- endif %}{% endfor %}
    </ul>
    {%- endif %}
    {%- if formats.size > 0 %}
    <a class="pill-button outline reveal" style="--delay: 450ms" href="#formats">{{ formats_heading | escape }}</a>
    {%- endif %}
  </div>
</section>
{%- endif %}

{%- if formats.size > 0 or moments.size > 0 %}
<div class="maroon">
  {%- if formats.size > 0 %}
  <section class="formats" id="formats" aria-labelledby="formats-title">
    <h2 id="formats-title" class="display-title reveal">{{ formats_heading_html }}</h2>
    <div class="stagger">
      {%- for column in (1..2) %}
      <ul class="stagger-column">
        {%- for format in formats %}
        {%- assign side = forloop.index0 | modulo: 2 | plus: 1 -%}
        {%- if side == column and format.name != blank %}
        <li class="format reveal" style="--delay: {{ forloop.index | times: 120 }}ms">
          <h3 class="item-title">{{ format.name | escape }}</h3>
          {%- if format.fee != blank %}<p class="format-fee">{{ format.fee | escape }}</p>{% endif %}
          {%- if format.players != blank or format.length != blank %}
          <p class="item-meta">{% if format.players != blank %}{{ format.players | escape }}{% endif %}{% if format.players != blank and format.length != blank %}<br>{% endif %}{% if format.length != blank %}{{ format.length | escape }}{% endif %}</p>
          {%- endif %}
          {%- if format.note != blank %}<p class="item-text">{{ format.note | escape }}</p>{% endif %}
        </li>
        {%- endif %}
        {%- endfor %}
      </ul>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if moments.size > 0 %}
  <section class="repertoire" id="repertoire" aria-labelledby="repertoire-title">
    <h2 id="repertoire-title" class="display-title reveal">{{ repertoire_heading | escape }}</h2>
    <div class="stagger">
      {%- for column in (1..2) %}
      <div class="stagger-column">
        {%- for moment in moments %}
        {%- assign side = forloop.index0 | modulo: 2 | plus: 1 -%}
        {%- if side == column %}
        <div class="moment reveal" style="--delay: {{ forloop.index | times: 120 }}ms">
          <h3 class="item-title">{{ moment.name | escape }}</h3>
          {%- if moment.note != blank %}<p class="item-text">{{ moment.note | escape }}</p>{% endif %}
          {%- if moment.piece.size > 0 %}
          <ol class="pieces">
            {%- for piece in moment.piece %}{% if piece.title != blank %}
            <li class="piece" data-row>
              {%- if piece.sample != blank %}
              {%- assign sample_url = piece.sample.url -%}
              {%- if piece.composer != blank %}{% assign sample_label = piece.title | append: ", " | append: piece.composer %}{% else %}{% assign sample_label = piece.title %}{% endif %}
              {% include 'sample-button' %}
              {%- else %}
              <span class="play-space" aria-hidden="true"></span>
              {%- endif %}
              <span class="piece-text"><span class="piece-title">{{ piece.title | escape }}</span>{% if piece.composer != blank %}<span class="piece-composer">{{ piece.composer | escape }}</span>{% endif %}</span>
              <span class="piece-progress" aria-hidden="true"></span>
            </li>
            {%- endif %}{% endfor %}
          </ol>
          {%- endif %}
        </div>
        {%- endif %}
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}
  {%- if site.program_fog != blank %}
  <img class="fog fog-maroon" src="{{ site.program_fog.url | escape }}" alt="" aria-hidden="true">
  {%- endif %}
</div>
{%- endif %}

{%- if word_count > 0 %}
{%- if site.quote_image != blank %}{% assign quote_bg = site.quote_image.url %}{% elsif site.hero_image != blank %}{% assign quote_bg = site.hero_image.url %}{% else %}{% assign quote_bg = "" %}{% endif %}
<section class="kind-words" aria-labelledby="kind-words-title">
  {%- if quote_bg != "" %}
  <img class="kind-media" src="{{ quote_bg | escape }}" alt="" loading="lazy">
  {%- endif %}
  <div class="kind-shade" aria-hidden="true"></div>
  <h2 id="kind-words-title" class="visually-hidden">{{ kind_words_heading | escape }}</h2>
  <ul class="quotes reveal-scale" data-quotes>
    {%- for word in kind_words %}{% if word.quote != blank %}
    <li class="quote-slide">
      <figure>
        <blockquote><p>{{ word.quote | escape }}</p></blockquote>
        {%- if word.name != blank or word.detail != blank %}
        <figcaption>{% if word.name != blank %}<span class="quote-name">{{ word.name | escape }}</span>{% endif %}{% if word.detail != blank %}<span class="quote-detail">{{ word.detail | escape }}</span>{% endif %}</figcaption>
        {%- endif %}
      </figure>
    </li>
    {%- endif %}{% endfor %}
  </ul>
</section>
{%- endif %}

{%- if concerts.size > 0 %}
<section class="concerts" id="concerts" aria-labelledby="concerts-title">
  <h2 id="concerts-title" class="display-title reveal">{{ concerts_heading | escape }}</h2>
  <ol class="concert-list">
    {%- for concert in concerts %}{% if concert.title != blank %}
    <li class="concert reveal" style="--delay: {{ forloop.index | times: 100 }}ms">
      <p class="concert-date"><span class="concert-day">{{ concert.date | date: "%-d" }}</span><span class="concert-month">{{ concert.date | date: "%B %Y" }}</span></p>
      <div class="concert-body">
        <p class="concert-title">{{ concert.title | escape }}</p>
        {%- if concert.venue != blank or concert.city != blank %}
        <p class="item-meta">{% if concert.venue != blank %}{{ concert.venue | escape }}{% endif %}{% if concert.venue != blank and concert.city != blank %}, {% endif %}{% if concert.city != blank %}{{ concert.city | escape }}{% endif %}</p>
        {%- endif %}
      </div>
      {%- if concert.url != blank %}
      {%- assign link = concert.url | strip -%}{%- include 'link-href' %}
      <a class="pill-button outline small" href="{{ link_href | escape }}">Details<span class="visually-hidden"> for {{ concert.title | escape }}</span></a>
      {%- endif %}
    </li>
    {%- endif %}{% endfor %}
  </ol>
</section>
{%- endif %}

{%- if site.email != blank or site.booking_url != blank %}
<section class="inquire" id="inquire" aria-labelledby="inquire-title">
  <h2 id="inquire-title" class="display-title reveal">{% if site.inquire_heading != blank %}{{ site.inquire_heading | escape }}{% else %}Book us{% endif %}</h2>
  {%- if site.inquire_note != blank %}
  <p class="inquire-note reveal" style="--delay: 150ms">{{ site.inquire_note | escape }}</p>
  {%- endif %}
  <p class="inquire-actions reveal" style="--delay: 300ms">
    {%- if site.email != blank %}
    <a class="pill-button glass" href="mailto:{{ site.email | escape }}">Email {{ site.email | escape }}</a>
    {%- endif %}
    {%- if site.booking_url != blank %}
    {%- assign link = site.booking_url | strip -%}{%- include 'link-href' -%}
    <a class="pill-button outline" href="{{ link_href | escape }}">{% if site.booking_label != blank %}{{ site.booking_label | escape }}{% else %}Check a date{% endif %}</a>
    {%- endif %}
  </p>
</section>
{%- endif %}
