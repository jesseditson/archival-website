{% layout 'theme' title: "" %}

<nav class="nav">
  <div class="container">
    <div class="brand">
      {% if app.logo != blank %}
        <a href="/">
          <img
            class="app-logo"
            src="{{ app.logo.url }}"
            alt="{{ app.name }}" />
        </a>
      {% endif %}
      <span class="app-name">
        {{ app.name }}
      </span>
    </div>
    <div class="nav-items">
      {% if app.features_title != blank %}<a class="nav-item" href="#features">{{ app.features_title }}</a>{% endif %}
      {% if support.title != blank %}<a class="nav-item" href="#support">{{ support.title }}</a>{% endif %}
    </div>
  </div>
</nav>

<main id="main">
<header class="hero">
  <div class="container">
    <div class="hero-statement">
      <h1>{{ app.name }}</h1>
      {% if app.hero_supplement != blank %}<span class="supplement">{{ app.hero_supplement }}</span>{% endif %}
      <div class="download-options">
        {% if app.appstore_download_link != blank %}
          <a href="{{ app.appstore_download_link }}">
            <img class="app-store-download" src="/images/app-store-black.svg" alt="Download on the App Store" />
          </a>
        {% endif %}
        {% if app.playstore_download_link != blank %}
          <a href="{{ app.playstore_download_link }}">
            <img class="play-store-download" src="/images/play-store-black.svg" alt="Get it on Google Play" />
          </a>
        {% endif %}
        {% if app.direct_download_link != blank %}
          <a href="{{ app.direct_download_link }}">
            <button class="button">Download</button>
          </a>
        {% endif %}
      </div>
    </div>
    {% if screenshots.size > 0 %}
      <div class="screenshots">
        {% for screenshot in screenshots %}
          <div class="screenshot-container {{ screenshot.frame }} {% unless forloop.first %}hidden{% endunless %}">
            <img
              class="screenshot"
              src="{{ screenshot.image.url }}"
              alt="{{ screenshot.description }}" />
            <div class="screenshot-frame"></div>
          </div>
        {% endfor %}
        {% if screenshots.size > 1 %}
          <div class="screenshot-page-icons">
            {% for page in (1..screenshots.size) %}
              <div data-page="{{ page }}" class="screenshot-page-icon {% if forloop.first %}active{% endif %}"></div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</header>

<div class="container">

  {% if app.features_title != blank %}<h2>{{ app.features_title }}</h2>{% endif %}

  <section id="features" class="features-grid">
    {% for feature in features %}
      <div class="feature">
        {% if feature.icon != blank %}
          <div class="feature-icon has-image" style="background-image:url('{{ feature.icon.url }}')"></div>
        {% else %}
          <div class="feature-icon">{{ feature.emoji }}</div>
        {% endif %}
        <div class="feature-text">
          <h3>{{ feature.title }}</h3>
          <p class="feature-description">
            {{ feature.desc }}
          </p>
        </div>
      </div>
    {% endfor %}
  </section>

  {% if support.email != blank or support.chat_link != blank %}
    <section id="support" class="support">
      {% if support.title != blank %}<h2>{{ support.title }}</h2>{% endif %}
      <div class="support-modules">
        {% if support.email != blank %}
          <div class="email-support module">
            <a href="mailto:{{ support.email }}">Send us an email &rarr;</a>
          </div>
        {% endif %}
        {% if support.chat_link != blank %}
          <div class="chat-support module">
            <a href="{{ support.chat_link }}">Live chat support &rarr;</a>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

</div>
</main>

<script
  src="/screenshots.js"
  type="application/javascript"
  defer></script>
