{% layout 'theme' title: "" %}

<nav class="nav">
  <div class="container">
    <div class="brand">
      {% if app.logo != blank %}
      <a href="/">
        <img class="app-logo" src="{{ app.logo.url }}" alt="{{ app.name }}" />
      </a>
      {% endif %}
      <span class="app-name">
        {{ app.name }}
      </span>
    </div>
    <div class="nav-items">
      {% if support.title != blank %}<a class="nav-item" href="#support">{{ support.title }}</a>{% endif %}
      <div class="download-options">
        {% if app.direct_download_link != blank %}
        <a href="{{ app.direct_download_link }}">
          <button class="button">Download</button>
        </a>
        {% endif %}
        {% if app.playstore_download_link != blank %}
        <a href="{{ app.playstore_download_link }}">
          <img class="play-store-download" src="/images/play-store-black.svg" alt="Get it on Google Play" />
        </a>
        {% endif %}
        {% if app.appstore_download_link != blank %}
        <a href="{{ app.appstore_download_link }}">
          <img class="app-store-download" src="/images/app-store-black.svg" alt="Download on the App Store" />
        </a>
        {% endif %}
      </div>
    </div>
  </div>
</nav>

<main id="main">

<header class="hero">
  <div class="container">
    <div class="hero-statement">
      <h1>{{ app.tagline }}</h1>
      {% if app.hero_description != blank %}
        <p class="hero-description">{{ app.hero_description }}</p>
      {% endif %}
    </div>
  </div>
</header>

<section class="image-carousel-section">
  <div class="image-carousel" id="imageCarousel" role="region" aria-roledescription="carousel" aria-label="Screenshots">
    <div class="carousel-track" id="carouselTrack">
      {% for screenshot in screenshots %}
      <div class="carousel-slide {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
        <img src="{{ screenshot.image.url }}" alt="Screenshot {{ forloop.index }}" />
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<div class="container">

  <section id="features" class="features-grid">
    {% for feature in features %}
    <div class="feature">
      <div class="feature-icon">
        {% if feature.icon != blank %}<i class="ph-bold ph-{{ feature.icon }}"></i>{% endif %}
      </div>
      <div class="feature-text">
        <h3>{{ feature.title }}</h3>
      </div>
    </div>
    {% endfor %}
  </section>

  {% if support.email != blank or support.chat_link != blank or support.discord_link != blank %}
  <section id="support" class="support">
    {% if support.title != blank %}<h2>{{ support.title }}</h2>{% endif %}
    {% if support.description != blank %}<p class="description">{{ support.description }}</p>{% endif %}
    <div class="support-modules">
      {% if support.chat_link != blank %}
      <div class="chat-support module">
        <a href="{{ support.chat_link }}">{{ support.chat_label | default: "Chat" }}</a>
      </div>
      {% endif %}
      {% if support.email != blank %}
      <div class="email-support module">
        <a href="mailto:{{ support.email }}">Email</a>
      </div>
      {% endif %}
      {% if support.discord_link != blank %}
      <div class="discord-support module">
        <a href="{{ support.discord_link }}">Discord</a>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

</div>
</main>

<script src="/carousel.js" type="application/javascript" defer></script>
