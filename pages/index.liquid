{% layout 'theme' title: ''
  , page: 'home' %}

{% for story in stories %}
  {% if story.featured %}
    <div class="front-page">
      <article class="featured-story">
        <div class="featured-image-wrap">
          <a href="{{ story.path }}.html">
            {% if story.image != blank %}
              <img class="featured-image" src="{{ story.image.url }}" alt="{{ story.image_caption }}">
            {% else %}
              <div class="image-placeholder featured-image-placeholder" data-section="{{ story.section | downcase }}"><span class="image-placeholder-text">{{ story.section }}</span></div>
            {% endif %}
          </a>
        </div>
        <div class="featured-text">
          <p class="featured-section">
            <a href="{% include 'section_href', section_name: story.section %}">{{ story.section }}</a>
          </p>
          <h2 class="featured-headline">
            <a href="{{ story.path }}.html">{{ story.headline }}</a>
          </h2>
          <p class="featured-subheadline">{{ story.subheadline }}</p>
          {% assign words = story.body | strip_html | split: ' ' | size %}
          {% assign reading_time = words | plus: 199 | divided_by: 200 %}
          {% if reading_time < 1 %}{% assign reading_time = 1 %}{% endif %}
          <p class="featured-meta">
            By {{ story.author }} &middot; {{ story.date }} &middot; {{ reading_time }} min read
          </p>
        </div>
      </article>
    </div>
    {% break %}
  {% endif %}
{% endfor %}

<div class="front-page">
  <div class="story-grid">
    {% for story in stories %}
      {% unless story.featured %}
        <article class="story-card">
          <a href="{{ story.path }}.html">
            {% if story.image != blank %}
              <img class="story-card-image" src="{{ story.image.url }}" alt="{{ story.image_caption }}">
            {% else %}
              <div class="image-placeholder story-card-image-placeholder" data-section="{{ story.section | downcase }}"><span class="image-placeholder-text">{{ story.section }}</span></div>
            {% endif %}
          </a>
          <p class="story-card-section">
            <a href="{% include 'section_href', section_name: story.section %}">{{ story.section }}</a>
          </p>
          <h3 class="story-card-headline">
            <a href="{{ story.path }}.html">{{ story.headline }}</a>
          </h3>
          <p class="story-card-subheadline">{{ story.subheadline }}</p>
          {% assign words = story.body | strip_html | split: ' ' | size %}
          {% assign reading_time = words | plus: 199 | divided_by: 200 %}
          {% if reading_time < 1 %}{% assign reading_time = 1 %}{% endif %}
          <p class="story-card-meta">
            By {{ story.author }} &middot; {{ story.date }} &middot; {{ reading_time }} min read
          </p>
        </article>
      {% endunless %}
    {% endfor %}
  </div>
  <div class="load-more-sentinel" id="load-more-sentinel">
    <div class="load-more-inner">
      <div class="load-more-spinner"></div>
      <span>Loading more story</span>
    </div>
  </div>
</div>

<script src="/js/load-more.js"></script>
