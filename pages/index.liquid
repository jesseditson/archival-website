{% assign personal = objects.personal %}
{% assign experience = objects.experience %}
{% assign work = objects.work %}
{% assign contact = objects.contact %}
{% assign resume = objects.resume %}
{% layout 'theme' title: "" %}

<!-- Navigation Bar -->
<nav class="navbar">
  <div class="container">
    <div class="logo-group">
      <a href="#hero" class="logo">{{ personal.name }}</a>
      {% if personal.title != blank %}<span class="logo-pill">{{ personal.title }}</span>{% endif %}
    </div>
    <ul class="nav-links" id="primary-nav">
      <li>
        <a href="#about">About</a>
      </li>
      <li>
        <a href="#experience">Experience</a>
      </li>
      <li>
        <a href="#work">Work</a>
      </li>
      <li>
        <a href="#contact">Contact</a>
      </li>
      {% if resume.file != blank %}
        <li>
          <a
            href="{{ resume.file.url }}"
            class="resume-button"
            download="{{ resume.file.filename }}">Resume</a>
        </li>
      {% endif %}
    </ul>
    <button type="button" class="hamburger" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="primary-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Hero Section -->
<section id="hero">
  <div class="container">
    <p class="intro">Hi, my name is</p>
    <h1 class="name">{{ personal.name }} &amp;</h1>
    <h2 class="profession">{{ personal.action_line }}</h2>
    <p class="description">
      {{ personal.tagline }}
    </p>
    <a href="#about" class="cta">More about me</a>
  </div>
</section>

<!-- About Section -->
<section id="about">
  <div class="container">
    <h2 class="section-title">About Me</h2>
    <div class="content">
      <div class="text markdown">
        {{ personal.full_about }}
      </div>
    </div>
  </div>
</section>

<!-- Experience Section -->
<section id="experience">
  <div class="container">
    <h2 class="section-title">{{ experience.title }}</h2>
    {% if experience.description != blank %}
    <div class="experience-intro markdown">{{ experience.description }}</div>
    {% endif %}
    <div class="experience">
      {% for job in experience.job %}
        <div class="experience-item">
          <div class="experience-header">
            <h3 class="experience-job-title">{{ job.title }}</h3>
            {% if job.company != blank %}<span class="experience-company">{{ job.company }}</span>{% endif %}
            {% if job.dates != blank %}<span class="experience-dates">{{ job.dates }}</span>{% endif %}
          </div>
          <div class="experience-description markdown">
            {{ job.description }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Work Section -->
<section id="work">
  <div class="container">
    <h2 class="section-title">{{ work.title }}</h2>
    {% if work.description != blank %}
    <div class="work-intro markdown">{{ work.description }}</div>
    {% endif %}
    <!-- Projects -->
    <div class="projects">
      {% for project in work.project %}
        <div class="project-item">
          <div class="project-content">
            <h3>{{ project.name }}</h3>
            <div class="project-description markdown">{{ project.description }}</div>
            <div class="project-tags">
              {%- for tag in project.tag -%}
                <span>{{ tag.name }}</span>
              {%- endfor -%}
            </div>
          </div>
          {%- if project.image != blank -%}
            <div class="project-image">
              <img src="{{project.image.url}}" alt="{{project.name}}">
            </div>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Contact Section -->
<section id="contact">
  <div class="container">
    <div class="contact-card">
      <h2 class="section-title">{{ contact.title }}</h2>
      <div class="contact-description markdown">
        {{ contact.description }}
        <a href="mailto:{{ contact.email }}" class="email-link">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="position: relative; z-index: 1;">
            <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
            <path d="m21.854 2.147-10.94 10.939" />
          </svg>
          <span style="position: relative; z-index: 1;">Say Hello</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer>
  <div class="container">
    <p>&copy; {{ "now" | date: "%Y" }} {{ personal.name }}. Powered by <a href="https://archival.dev">Archival</a>.</p>
  </div>
</footer>
