{% layout 'theme' title: objects.site.name %}
{% assign base_map_url = "https://www.google.com/maps/embed/v1/place?key=AIzaSyBdU_Na_rXyj8E1cfyr9wxJjlK_VTwAK2s&q=" %}
{% assign map_address = objects.location.address | url_encode %}
{% assign map_embed_url = base_map_url | append: map_address %}

<div class="content">
  <header class="header">
    <div class="container">
      <div class="logo-container">
        {% if objects.site.logo_image.url %}
          <img
            src="{{ objects.site.logo_image.url }}"
            alt="{{ objects.site.name }} Logo"
            class="logo">
        {% endif %}
      </div>
      <h1 class="business-name">{{ objects.site.name }}</h1>
      <p class="tagline">{{ objects.site.tagline }}</p>
    </div>
  </header>

  <main>
    <section class="hours">
      <div class="container">
        <h2 class="reveal">Hours</h2>
        <ul class="reveal-stagger">
          <li class="reveal">
            <span>Monday – Friday</span>
            <span>{{ objects.hours.monday_friday }}</span>
          </li>
          <li class="reveal">
            <span>Saturday</span>
            <span>{{ objects.hours.saturday }}</span>
          </li>
          <li class="reveal">
            <span>Sunday</span>
            <span>{{ objects.hours.sunday }}</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="location">
      <div class="container">
        <h2 class="reveal">Location</h2>
        <p class="reveal">{{ objects.location.address }}</p>
        <div class="map reveal">
          <iframe
            src="{{ map_embed_url }}"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>

    <section class="contact-info">
      <div class="container">
        <h2 class="reveal">Contact Us</h2>
        <div class="contact-cards reveal-stagger">
          <a href="tel:{{ objects.contact.phone }}" class="contact-card reveal">
            <span class="contact-card-label">Phone</span>
            <span class="contact-card-value">{{ objects.contact.phone }}</span>
          </a>
          <a href="mailto:{{ objects.contact.email }}" class="contact-card reveal">
            <span class="contact-card-label">Email</span>
            <span class="contact-card-value">{{ objects.contact.email }}</span>
          </a>
        </div>
      </div>
    </section>

    <section class="about">
      <div class="container">
        <h2 class="reveal">About Us</h2>

        <div class="about-content reveal">
          <div class="about-text">
            {{ about.description }}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <p class="footer-name">{{ objects.site.name }}</p>
          <p class="footer-tagline">{{ objects.site.tagline }}</p>
        </div>
        <div class="footer-details">
          {% assign address_parts = objects.location.address | split: ", " %}
          <p>{{ address_parts[0] }}</p>
          <p>{{ address_parts[1] }}, {{ address_parts[2] }}</p>
          <p>{{ objects.contact.phone }}</p>
          <p><a href="mailto:{{ objects.contact.email }}">{{ objects.contact.email }}</a></p>
        </div>
        <div class="footer-hours">
          <p>Mon–Fri {{ objects.hours.monday_friday }}</p>
          <p>Sat {{ objects.hours.saturday }}</p>
          <p>Sun {{ objects.hours.sunday }}</p>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="copyright">&copy; {{ "now" | date: "%Y" }} {{ objects.site.name }}</p>
      </div>
    </div>
  </footer>
</div>
