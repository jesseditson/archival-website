{% layout 'theme' title: objects.site.home_title %}

<header>
  <h1 class="masthead">{{ objects.site.home_title }}</h1>
</header>

<div class="main-container">
  <section id="video-section" class="video-container">
    {% if objects.site.video != blank %}
      <video
        crossOrigin="anonymous"
        id="myVideo"
        src="{{ objects.site.video.url }}"
        controls></video>
    {% elsif objects.site.video_url != blank %}
      <video
        crossOrigin="anonymous"
        id="myVideo"
        src="{{ objects.site.video_url }}"
        controls></video>
    {% endif %}
  </section>

  <section id="widgets"></section>
</div>

<footer>
  <p>&copy; {{ "now" | date: "%Y" }} {{ objects.site.copyright_name }}. Powered by <a href="https://archival.dev">Archival</a>.</p>
</footer>
