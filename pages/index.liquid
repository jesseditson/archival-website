{% layout 'theme' title: "", page: 'home' %}

<!-- Hero -->
<section class="hero">
  {% if objects.site.hero_image != blank %}
    <div class="hero-bg" style="background-image: url('{{ objects.site.hero_image.url }}');"></div>
  {% endif %}
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-tagline">{{ objects.site.tagline }}</p>
    <h1>{{ objects.site.name }}</h1>
    <div class="hero-ctas">
      <a href="/menu" class="btn">View Menu</a>
      {% if objects.site.reservation_url != blank %}
        <a href="{{ objects.site.reservation_url }}" class="btn btn-filled" target="_blank" rel="noopener noreferrer">Reserve a Table</a>
      {% endif %}
    </div>
  </div>
</section>

<!-- Featured Items -->
{% assign has_featured = false %}
{% for cat in objects.site.category %}
  {% for item in cat.menu_item %}
    {% if item.featured %}{% assign has_featured = true %}{% endif %}
  {% endfor %}
{% endfor %}
{% if has_featured %}
<section class="section featured fade-in">
  <div class="container">
    <span class="label">From Our Kitchen &amp; Bar</span>
    <h2>The Signatures</h2>
    <div class="featured-grid">
      {% for cat in objects.site.category %}
        {% for item in cat.menu_item %}
          {% if item.featured %}
            <div class="featured-item">
              <h3>{{ item.name }}</h3>
              <p>{{ item.description }}</p>
              <span class="price">{{ item.price }}</span>
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    <a href="/menu" class="btn featured-cta">View Full Menu</a>
  </div>
</section>
{% endif %}

<hr class="divider">

<!-- About / Vibe -->
{% if objects.site.description != blank or objects.site.polaroid_1 != blank or objects.site.polaroid_2 != blank or objects.site.polaroid_3 != blank %}
<section class="section about fade-in">
  <div class="container">
    <div class="about-grid">
      <div class="about-text">
        <span class="label">Our Story</span>
        <h2>The Vibe</h2>
        <div class="about-body">
          {{ objects.site.description }}
        </div>
      </div>
      <div class="about-photos">
        {% if objects.site.polaroid_1 != blank %}
        <div class="polaroid polaroid-1 fade-in">
          <img src="{{ objects.site.polaroid_1.url }}" alt="{{ objects.site.polaroid_1_description }}">
        </div>
        {% endif %}
        {% if objects.site.polaroid_2 != blank %}
        <div class="polaroid polaroid-2 fade-in">
          <img src="{{ objects.site.polaroid_2.url }}" alt="{{ objects.site.polaroid_2_description }}">
        </div>
        {% endif %}
        {% if objects.site.polaroid_3 != blank %}
        <div class="polaroid polaroid-3 fade-in">
          <img src="{{ objects.site.polaroid_3.url }}" alt="{{ objects.site.polaroid_3_description }}">
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<hr class="divider">
{% endif %}

<!-- Hours & Location -->
<section class="section info fade-in">
  <div class="container">
    <span class="label">Find Us</span>
    <h2>Hours &amp; Location</h2>

    <div class="info-location-grid">
      {% if objects.contact.address != blank %}
        <div class="info-map">
          <iframe
            src="https://www.google.com/maps?q={{ objects.contact.address | url_encode }}&output=embed"
            width="100%"
            height="100%"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map showing {{ objects.site.name }} location">
          </iframe>
        </div>
      {% endif %}
      <div class="info-details">
        <span class="label">Location</span>
        {% if objects.contact.address != blank %}
          <p class="info-address">{{ objects.contact.address | replace_first: ", ", "<br>" }}</p>
        {% endif %}
        {% if objects.contact.phone != blank %}
          <p><a href="tel:{{ objects.contact.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' }}">{{ objects.contact.phone }}</a></p>
        {% endif %}
        {% if objects.contact.email != blank %}
          <p><a href="mailto:{{ objects.contact.email }}">{{ objects.contact.email }}</a></p>
        {% endif %}
        {% if objects.contact.address != blank %}
          <a href="https://www.google.com/maps/search/?api=1&query={{ objects.contact.address | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn info-directions-btn">Get Directions</a>
        {% endif %}
      </div>
    </div>

    {% if objects.hours.size > 0 %}
    <div class="hours-grid">
      <h3 class="hours-heading">Hours</h3>
      <div class="hours-cards">
        {% for h in objects.hours %}
        <div class="hours-card{% if h.closed %} hours-card-closed{% endif %}">
          <span class="hours-day">{{ h.day }}</span>
          <span class="hours-range">{% if h.closed %}<span class="hours-closed">Closed</span>{% else %}<span class="hours-time">{{ h.time }}</span>{% endif %}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

<!-- Events -->
{% if objects.event.size > 0 %}
<hr class="divider">
<section class="section events fade-in">
  <div class="container">
    <span class="label">What's Happening</span>
    <h2>Upcoming Events</h2>
    <div class="events-grid">
      {% for ev in objects.event %}
        {% include 'event-card'
          event_title: ev.title,
          event_date: ev.date,
          event_description: ev.description,
          event_link: ev.link
        %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Instagram CTA -->
{% if objects.contact.instagram != blank %}
<hr class="divider">
<section class="instagram-cta fade-in">
  <span class="label">Follow Along</span>
  {% assign ig_handle = objects.contact.instagram | remove: '@' %}
  <a href="https://instagram.com/{{ ig_handle }}" target="_blank" rel="noopener noreferrer">@{{ ig_handle }}</a>
</section>
{% endif %}
