{%- assign site = objects.site -%}
{%- assign formats = objects.format | sort: "order" -%}
{%- assign moments = objects.moment | sort: "order" -%}
{%- assign concerts = objects.concert | sort: "date" -%}
# {{ site.name }}
{% if site.tagline != blank %}
> {{ site.tagline | strip_newlines }}
{% endif %}
{%- if site.description != blank %}
{{ site.description | strip_newlines }}
{% endif %}
{%- if site.location != blank %}
Based in {{ site.location }}.
{% endif %}
{%- assign member_count = 0 -%}{%- for member in objects.member -%}{%- if member.name != blank -%}{%- assign member_count = member_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if member_count > 0 %}
## Players

{% assign members = objects.member | sort: "order" %}{% for member in members %}{% if member.name != blank %}- {{ member.name }}{% if member.instrument != blank %}, {{ member.instrument }}{% endif %}
{% endif %}{% endfor %}
{%- endif %}
{%- if formats.size > 0 %}
## Formats and fees

{% for format in formats %}{% if format.name != blank %}- {{ format.name }}{% if format.fee != blank %}: {{ format.fee }}{% endif %}{% if format.length != blank %}, {{ format.length }}{% endif %}{% if format.players != blank %} ({{ format.players }}){% endif %}
{% endif %}{% endfor %}
{%- endif %}
{%- if moments.size > 0 %}
## Repertoire
{% for moment in moments %}
### {{ moment.name }}

{% for piece in moment.piece %}{% if piece.title != blank %}- {{ piece.title }}{% if piece.composer != blank %}, {{ piece.composer }}{% endif %}
{% endif %}{% endfor %}{% endfor %}
{%- endif %}
{%- if concerts.size > 0 %}
## Concerts

{% for concert in concerts %}{% if concert.title != blank %}- {{ concert.date | date: "%B %-d, %Y" }}: {{ concert.title }}{% if concert.venue != blank %}, {{ concert.venue }}{% endif %}{% if concert.city != blank %}, {{ concert.city }}{% endif %}
{% endif %}{% endfor %}
{%- endif %}
{%- if site.email != blank or site.booking_url != blank %}
## Booking

{% if site.email != blank %}- {{ site.email }}
{% endif %}{% if site.booking_url != blank %}- {{ site.booking_url }}
{% endif %}
{%- endif %}
