{%- assign site = objects.site -%}
{%- assign stops = objects.stop | sort: "order" -%}
{%- assign specials = objects.special_stop | sort: "order" -%}
{%- assign dishes = objects.dish | sort: "order" -%}
{%- assign days = "monday,tuesday,wednesday,thursday,friday,saturday,sunday" | split: "," -%}
# {{ site.name }}
{% if site.description != blank %}
> {{ site.description }}
{% endif %}
{%- if site.tagline != blank %}
{{ site.tagline }}{% if site.cuisine != blank %} ({{ site.cuisine }}){% endif %}
{% endif %}
This is a food truck. It has no fixed address: the weekly schedule and special stops below say where it parks. "Today" on the website is worked out in the visitor's browser.
{% if site.closed_until != blank %}
## Closed

Closed until {{ site.closed_until | date: "%Y-%m-%d" }}{% if site.closed_note != blank %}: {{ site.closed_note }}{% endif %}. The weekly schedule resumes after that date.
{% endif %}
{%- if stops.size > 0 %}
## Weekly schedule
{% for day in days %}
{%- assign day_count = 0 -%}
{%- for v in stops -%}{%- if v.day == day -%}{%- assign day_count = day_count | plus: 1 %}
- {{ day | capitalize }}: {{ v.place }}{% if v.start != blank %}, {{ v.start }}{% if v.end != blank %} to {{ v.end }}{% endif %}{% endif %}{% if v.address != blank %} ({{ v.address }}){% endif %}{% if v.note != blank %}. {{ v.note }}{% endif %}
{%- endif -%}{%- endfor -%}
{%- if day_count == 0 %}
- {{ day | capitalize }}: off
{%- endif -%}
{%- endfor %}
{% endif %}
{%- if specials.size > 0 %}
## Special stops
{% for v in specials %}
- {{ v.date | date: "%Y-%m-%d" }}: {{ v.place }}{% if v.start != blank %}, {{ v.start }}{% if v.end != blank %} to {{ v.end }}{% endif %}{% endif %}{% if v.address != blank %} ({{ v.address }}){% endif %}{% if v.note != blank %}. {{ v.note }}{% endif %}
{%- endfor %}
{% endif %}
{%- if dishes.size > 0 %}
## Menu
{% for d in dishes %}
- {{ d.name }}{% if d.price != blank %}, {{ d.price }}{% endif %}{% if d.description != blank %}: {{ d.description }}{% endif %}{% if d.spicy %} (spicy){% endif %}{% if d.vegetarian %} (vegetarian){% endif %}{% if d.sold_out %} (sold out){% endif %}
{%- endfor %}
{% endif %}
