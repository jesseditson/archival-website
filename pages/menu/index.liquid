{% layout 'theme' title: 'Menu', page: 'menu' %}

<!-- Category Navigation -->
<nav class="menu-nav" aria-label="Menu categories">
  <ul class="menu-nav-list">
    {% for cat in objects.site.category %}
      <li><a href="#{{ cat.name | downcase | replace: ' ', '-' }}">{{ cat.name }}</a></li>
    {% endfor %}
  </ul>
</nav>

<div class="container menu-page-content" style="padding-bottom: 4rem;">
  {% for cat in objects.site.category %}
    {% include 'menu-section' category_name: cat.name, items: cat.menu_item %}
  {% endfor %}
</div>
