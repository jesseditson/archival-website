{%- assign site = objects.site -%}
{%- assign p = post -%}
{%- include 'author_lookup' -%}
{%- capture ld_title %}{{ post.title | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endcapture -%}
{%- capture ld_desc %}{{ post.excerpt | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endcapture -%}
{%- capture ld_author %}{{ post.author | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endcapture -%}
{%- capture ld_site %}{{ site.name | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endcapture -%}
{%- assign share_image = "" -%}
{%- if post.feature_image != blank -%}{%- assign share_image = post.feature_image.url -%}{%- endif -%}
{%- capture ld_image %}{{ share_image | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endcapture -%}
{%- capture jsonld -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "{{ ld_title }}",
    "datePublished": "{{ post.date | date: '%Y-%m-%d' }}",
    "url": "{{ site_url }}/{{ post.path }}",
    "publisher": { "@type": "Organization", "name": "{{ ld_site }}" }
    {%- if post.excerpt != blank -%}, "description": "{{ ld_desc }}"{%- endif -%}
    {%- if post.author != blank -%}, "author": { "@type": "Person", "name": "{{ ld_author }}"{%- if found_author != blank and site_url != blank -%}, "url": "{{ site_url }}/{{ found_author.path }}"{%- endif -%} }{%- endif -%}
    {%- if share_image != blank -%}, "image": "{{ ld_image }}"{%- endif -%}
    {%- if post.tag.size > 0 -%}, "keywords": [{%- for t in post.tag -%}{%- capture ld_tag %}{{ t.name | replace: '\', '\\' | replace: '"', '\"' | replace: '</', '<\/' | strip_newlines }}{% endcapture -%}"{{ ld_tag }}"{%- unless forloop.last -%}, {% endunless -%}{%- endfor -%}]{%- endif -%}
  }
</script>
{%- endcapture -%}
{% layout 'theme' title: post.title, path: post.path, description: post.excerpt, og_type: "article", image: share_image, jsonld: jsonld %}

<article class="article">
  <header class="article-header">
    {% include 'primary_tag', p: post %}
    {%- include 'longest', text: post.title -%}
    <h1 class="article-title" style="--longest: {{ longest }}">{{ post.title | escape }}</h1>
    {% if post.excerpt != blank %}<p class="article-excerpt">{{ post.excerpt | escape }}</p>{% endif %}
    {% include 'byline', p: post %}
  </header>

  {% if post.video != blank %}
  <figure class="article-image article-video">
    <video src="{{ post.video.url | escape }}" controls playsinline preload="metadata"{% if post.feature_image != blank %} poster="{{ post.feature_image.url | escape }}"{% endif %}{% if post.feature_image_alt != blank %} aria-label="{{ post.feature_image_alt | escape }}"{% endif %}></video>
    {% if post.feature_image_caption != blank %}<figcaption>{{ post.feature_image_caption | escape }}</figcaption>{% endif %}
  </figure>
  {% elsif post.feature_image != blank %}
  <figure class="article-image">
    <img src="{{ post.feature_image.url | escape }}" alt="{{ post.feature_image_alt | escape }}">
    {% if post.feature_image_caption != blank %}<figcaption>{{ post.feature_image_caption | escape }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  {% if post.audio != blank %}
  <figure class="audio-card" data-audio-card>
    <audio src="{{ post.audio.url | escape }}" controls preload="metadata"></audio>
    <div class="audio-ui" hidden>
      <button type="button" class="audio-play" aria-label="Play">
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z"/></svg>
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
      </button>
      <div class="audio-body">
        <p class="audio-title">{{ post.audio_title | default: post.title | escape }}</p>
        <div class="audio-row">
          <span class="audio-time" data-audio-current>0:00</span>
          <input class="audio-seek" type="range" min="0" max="100" step="0.1" value="0" aria-label="Seek">
          <span class="audio-time" data-audio-duration>0:00</span>
        </div>
      </div>
    </div>
  </figure>
  {% endif %}

  <div class="article-body markdown">{{ post.content }}</div>

  {% if post.link != blank %}
  {%- assign link_host = post.link | remove_first: "https://" | remove_first: "http://" | remove_first: "www." | split: "/" | first -%}
  <a class="bookmark" href="{{ post.link | escape }}">
    <span class="bookmark-title">{{ post.link_title | default: link_host | escape }}</span>
    {% if post.link_description != blank %}<span class="bookmark-description">{{ post.link_description | escape }}</span>{% endif %}
    <span class="bookmark-host">{{ link_host | escape }}</span>
  </a>
  {% endif %}

  {% if post.tag.size > 1 %}
  <ul class="article-tags" aria-label="Tags">
    {% for t in post.tag %}
      {%- assign t_key = t.name | downcase | strip -%}
      {%- assign t_href = "" -%}
      {%- for tag_obj in objects.tag -%}{%- assign o_key = tag_obj.name | downcase | strip -%}{%- if o_key == t_key -%}{%- assign t_href = tag_obj.path -%}{%- endif -%}{%- endfor -%}
      <li>{% if t_href != blank %}<a href="/{{ t_href }}">{{ t.name | escape }}</a>{% else %}<span>{{ t.name | escape }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if found_author != blank %}
  <aside class="author-card" aria-label="About the author">
    {% include 'avatar', who: found_author, name: found_author.name, size: "large" %}
    <div class="author-card-text">
      <p class="author-card-name"><a href="/{{ found_author.path }}">{{ found_author.name | escape }}</a></p>
      {% if found_author.role != blank %}<p class="author-card-role">{{ found_author.role | escape }}</p>{% endif %}
    </div>
  </aside>
  {% endif %}
</article>

{% if post.audio != blank %}<script type="module" src="/js/audio-card.js"></script>{% endif %}

{% include 'subscribe' %}

{%- comment -%} Up to three other posts: those sharing this post's first tag, newest first, then the newest of the rest. {%- endcomment -%}
{%- assign sorted = objects.post | sort: "date" | reverse -%}
{%- assign own_key = "|" | append: post.path | append: "|" -%}
{%- assign picked = own_key -%}
{%- assign picked_count = 0 -%}
{%- assign primary_key = "" -%}
{%- if post.tag.size > 0 -%}{%- assign primary_key = post.tag.first.name | downcase | strip -%}{%- endif -%}
{%- if primary_key != blank -%}
  {%- for other in sorted -%}
    {%- assign o_path = "|" | append: other.path | append: "|" -%}
    {%- if picked_count < 3 -%}{%- unless picked contains o_path -%}
      {%- for t in other.tag -%}
        {%- assign t_key = t.name | downcase | strip -%}
        {%- if t_key == primary_key -%}{%- unless picked contains o_path -%}
          {%- assign picked = picked | append: other.path | append: "|" -%}
          {%- assign picked_count = picked_count | plus: 1 -%}
        {%- endunless -%}{%- endif -%}
      {%- endfor -%}
    {%- endunless -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- for other in sorted -%}
  {%- assign o_path = "|" | append: other.path | append: "|" -%}
  {%- if picked_count < 3 -%}{%- unless picked contains o_path -%}
    {%- assign picked = picked | append: other.path | append: "|" -%}
    {%- assign picked_count = picked_count | plus: 1 -%}
  {%- endunless -%}{%- endif -%}
{%- endfor -%}
{% if picked_count > 0 %}
<section class="read-more wrap" aria-labelledby="read-more-heading">
  <h2 class="section-heading" id="read-more-heading">{{ site.read_more_heading | default: "Keep reading" | escape }}</h2>
  <div class="read-more-grid">
    {% for other in sorted %}
      {%- assign o_path = "|" | append: other.path | append: "|" -%}
      {% if picked contains o_path and o_path != own_key %}
      <article class="read-more-item">
        {% include 'cover', p: other, cover_class: "read-more-image" %}
        {% include 'primary_tag', p: other %}
        <h3 class="read-more-title"><a href="/{{ other.path }}">{{ other.title | escape }}</a></h3>
        {% include 'byline', p: other %}
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}
