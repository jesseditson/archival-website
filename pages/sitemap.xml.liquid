<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site_url }}/</loc></url>
  {%- for post in objects.post %}
  <url><loc>{{ site_url }}/{{ post.path }}</loc><lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod></url>
  {%- endfor %}
  {%- for a in objects.author %}
  <url><loc>{{ site_url }}/{{ a.path }}</loc></url>
  {%- endfor %}
  {%- for t in objects.tag %}
  <url><loc>{{ site_url }}/{{ t.path }}</loc></url>
  {%- endfor %}
</urlset>
