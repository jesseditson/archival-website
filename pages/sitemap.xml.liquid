<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site_url }}/</loc></url>
{%- assign tracks = objects.track | sort: "order" %}
{%- for track in tracks %}
  <url><loc>{{ site_url }}/{{ track.path }}</loc></url>
{%- endfor %}
</urlset>
